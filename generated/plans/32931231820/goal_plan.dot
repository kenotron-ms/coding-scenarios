  LaunchLaneC [
    shape=parallelogram,
    label="Launch frontend_core (Wave 2, sequential)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json, subprocess, os, hashlib\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nintegration_head = subprocess.run([\"$git_bin\", \"rev-parse\", \"HEAD\"], cwd=\"$target_repo\", capture_output=True, text=True, check=True).stdout.strip()\nwt = gpr.create_registered_worktree(registry, (\"$git_bin\",), \"$target_repo\", \"$worktree_root\", \"frontend_core\", kind=\"lane\", commit_sha=integration_head, branch=\"issue-14/frontend_core\")\ncontract = {\n    \"schema_version\": \"goal-plan.process-launch-contract/v1\",\n    \"process_kind\": \"lane\", \"process_id\": \"frontend_core\", \"process_run_id\": \"$run_id-frontend_core\",\n    \"child_argv\": [\"python3\", \"-m\", \"amplifier_module_pipeline_runner.cli\", \"run\",\n                   \"$subgraphs_dir/goal_lane_impl.dot\", \"--cwd\", \".\", \"--on-human-gate\", \"fail\",\n                   \"--param\", \"lane_id=frontend_core\", \"--param\", \"marker_file=artifacts/frontend_core.done\",\n                   \"--param\", \"marker_content=frontend_core:ok\", \"--param\", \"seeded_failure=false\",\n                   \"--param\", \"runtime_py_dir=$runtime_py_dir\",\n                   \"--param\", \"output_root=$state_root/verify-out/frontend_core\",\n                   \"--param\", \"evidence_path=$state_root/evidence/frontend_core.json\",\n                   \"--param\", \"lane_result_path=$state_root/lane-results/frontend_core.json\",\n                   \"--param\", \"ledger_path=$state_root/budgets/frontend_core.json\",\n                   \"--param\", \"ledger_lock_path=$state_root/budgets/frontend_core.lock\",\n                   \"--param\", \"run_id=$run_id\", \"--param\", \"max_attempts=3\", \"--param\", \"goal_condition_file=/home/runner/work/coding-scenarios/coding-scenarios/generated/plans/32931231820/goals/frontend_core.goal.md\"],\n    \"child_cwd\": wt, \"child_env\": {\"PYTHONPATH\": \"$runner_pythonpath\"},\n    \"wall_timeout_seconds\": 3600, \"term_grace_seconds\": 10,\n    \"stdout_path\": \"$state_root/logs/frontend_core.stdout\", \"stderr_path\": \"$state_root/logs/frontend_core.stderr\",\n}\nos.makedirs(\"$state_root/contracts\", exist_ok=True)\nos.makedirs(\"$state_root/lane-results\", exist_ok=True)\nos.makedirs(\"$state_root/logs\", exist_ok=True)\nos.makedirs(\"$state_root/acks\", exist_ok=True)\nos.makedirs(\"$state_root/results\", exist_ok=True)\nwith open(\"$state_root/contracts/frontend_core.json\", \"w\") as f:\n    json.dump(contract, f, sort_keys=True)\ncontract_sha = hashlib.sha256(open(\"$state_root/contracts/frontend_core.json\", \"rb\").read()).hexdigest()\nintent = {\"schema_version\": \"goal-plan.launch-intent/v1\", \"process_run_id\": \"$run_id-frontend_core\", \"contract_sha256\": contract_sha}\nwith open(\"$state_root/contracts/frontend_core.intent.json\", \"w\") as f:\n    json.dump(intent, f, sort_keys=True)\nrc = subprocess.run([\"python3\", \"$runtime_py_dir/goal_plan_supervisor.py\", \"run\",\n    \"--contract\", \"$state_root/contracts/frontend_core.json\", \"--intent\", \"$state_root/contracts/frontend_core.intent.json\",\n    \"--ledger\", \"$state_root/supervisor-ledger.json\", \"--ack\", \"$state_root/acks/frontend_core.json\",\n    \"--result\", \"$state_root/results/frontend_core.json\"])\nsup = json.load(open(\"$state_root/results/frontend_core.json\")) if rc.returncode == 0 and os.path.exists(\"$state_root/results/frontend_core.json\") else {}\nprint(\"launched\" if sup.get(\"verdict\") == \"EXITED\" and sup.get(\"normalized_exit_code\") == 0 else \"crashed\")\nPYEOF"
