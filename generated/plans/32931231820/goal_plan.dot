  ParentVerifyC [
    shape=parallelogram,
    label="Parent-Verify frontend_core Candidate",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nlane_result = json.load(open(\"$state_root/lane-results/frontend_core.json\"))\nif lane_result.get(\"result\") != \"candidate\":\n    print(\"skip:\" + lane_result.get(\"blocker_reason\", \"unknown\"))\nelse:\n    registry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\n    result = gpr.run_parent_verifier_envelope(\n        registry=registry, git_argv_prefix=(\"$git_bin\",), target_repo=\"$target_repo\",\n        worktree_root=\"$worktree_root\", worktree_id=\"candidate-frontend_core\",\n        candidate_sha=lane_result[\"candidate_sha\"],\n        verifier_argv=['bash', '-c', 'test -f scenarios/L6-kanban-app/solution/frontend/src/api/client.ts && test -f scenarios/L6-kanban-app/solution/frontend/src/types/api.ts && test -f scenarios/L6-kanban-app/solution/frontend/src/store/boardStore.ts && test -f scenarios/L6-kanban-app/solution/frontend/src/store/authStore.ts && test -f scenarios/L6-kanban-app/solution/frontend/src/styles/tokens.css && cd scenarios/L6-kanban-app/solution/frontend && npm ci --silent && npx tsc --noEmit 2>&1 | tee /tmp/tsc_out.txt; lines=$(wc -l < /tmp/tsc_out.txt); test $lines -eq 0'],\n        timeout_seconds=300, output_root=\"$state_root/verify-out/candidate-frontend_core\",\n        evidence_path=\"$state_root/evidence/candidate-frontend_core.json\",\n    )\n    print(result.verdict)\nPYEOF"
  ];
  ParentVerifyC -> IntegrateC [condition="context.tool.last_line=PASS", weight="2"];
  ParentVerifyC -> InfraCarrier [condition="context.tool.last_line=INFRA"];
  ParentVerifyC -> Residuals [condition="context.tool.last_line=FAIL"];
  ParentVerifyC -> Residuals [condition="context.tool.last_line!=PASS"];
  IntegrateC [
    shape=parallelogram,
    label="Integrate frontend_core (merge + aggregate)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nlane_result = json.load(open(\"$state_root/lane-results/frontend_core.json\"))\njournal = gpr.IntegrationJournal(\"$state_root/integration-journal.json\", \"$state_root/integration-journal.lock\")\nentry = gpr.integrate_candidate(\n    git_argv_prefix=(\"$git_bin\",), integration_worktree=\"$target_repo\", journal=journal,\n    lane_id=\"frontend_core\", candidate_sha=lane_result[\"candidate_sha\"],\n    aggregate_verifier_argv=['/bin/sh', '-c', 'test -f artifacts/design_artifacts.done && test -f artifacts/backend_core.done && test -f artifacts/frontend_core.done'],\n    aggregate_timeout_seconds=300, output_root=\"$state_root/verify-out/aggregate-after-frontend_core\",\n    evidence_path=\"$state_root/evidence/aggregate-after-frontend_core.json\",\n)\nprint(entry[\"result\"])\nPYEOF"
  ];
  IntegrateC -> LaunchLaneD [condition="context.tool.last_line=ACCEPTED", weight="2"];
  IntegrateC -> InfraCarrier [condition="context.tool.last_line=AGGREGATE_INFRA"];
  IntegrateC -> Residuals [condition="context.tool.last_line=MERGE_CONFLICT"];
  IntegrateC -> Residuals [condition="context.tool.last_line=AGGREGATE_FAIL"];

  LaunchLaneD [
    shape=parallelogram,
    label="Launch integration_e2e (Wave 3, sequential)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json, subprocess, os, hashlib\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nintegration_head = subprocess.run([\"$git_bin\", \"rev-parse\", \"HEAD\"], cwd=\"$target_repo\", capture_output=True, text=True, check=True).stdout.strip()\nwt = gpr.create_registered_worktree(registry, (\"$git_bin\",), \"$target_repo\", \"$worktree_root\", \"integration_e2e\", kind=\"lane\", commit_sha=integration_head, branch=\"issue-14/integration_e2e\")\ncontract = {\n    \"schema_version\": \"goal-plan.process-launch-contract/v1\",\n    \"process_kind\": \"lane\", \"process_id\": \"integration_e2e\", \"process_run_id\": \"$run_id-integration_e2e\",\n    \"child_argv\": [\"python3\", \"-m\", \"amplifier_module_pipeline_runner.cli\", \"run\",\n                   \"$subgraphs_dir/goal_lane_impl.dot\", \"--cwd\", \".\", \"--on-human-gate\", \"fail\",\n                   \"--param\", \"lane_id=integration_e2e\", \"--param\", \"marker_file=artifacts/integration_e2e.done\",\n                   \"--param\", \"marker_content=integration_e2e:ok\", \"--param\", \"seeded_failure=false\",\n                   \"--param\", \"runtime_py_dir=$runtime_py_dir\",\n                   \"--param\", \"output_root=$state_root/verify-out/integration_e2e\",\n                   \"--param\", \"evidence_path=$state_root/evidence/integration_e2e.json\",\n                   \"--param\", \"lane_result_path=$state_root/lane-results/integration_e2e.json\",\n                   \"--param\", \"ledger_path=$state_root/budgets/integration_e2e.json\",\n                   \"--param\", \"ledger_lock_path=$state_root/budgets/integration_e2e.lock\",\n                   \"--param\", \"run_id=$run_id\", \"--param\", \"max_attempts=3\", \"--param\", \"goal_condition_file=/home/runner/work/coding-scenarios/coding-scenarios/generated/plans/32931231820/goals/integration_e2e.goal.md\"],\n    \"child_cwd\": wt, \"child_env\": {\"PYTHONPATH\": \"$runner_pythonpath\"},\n    \"wall_timeout_seconds\": 3600, \"term_grace_seconds\": 10,\n    \"stdout_path\": \"$state_root/logs/integration_e2e.stdout\", \"stderr_path\": \"$state_root/logs/integration_e2e.stderr\",\n}\nos.makedirs(\"$state_root/contracts\", exist_ok=True)\nos.makedirs(\"$state_root/lane-results\", exist_ok=True)\nos.makedirs(\"$state_root/logs\", exist_ok=True)\nos.makedirs(\"$state_root/acks\", exist_ok=True)\nos.makedirs(\"$state_root/results\", exist_ok=True)\nwith open(\"$state_root/contracts/integration_e2e.json\", \"w\") as f:\n    json.dump(contract, f, sort_keys=True)\ncontract_sha = hashlib.sha256(open(\"$state_root/contracts/integration_e2e.json\", \"rb\").read()).hexdigest()\nintent = {\"schema_version\": \"goal-plan.launch-intent/v1\", \"process_run_id\": \"$run_id-integration_e2e\", \"contract_sha256\": contract_sha}\nwith open(\"$state_root/contracts/integration_e2e.intent.json\", \"w\") as f:\n    json.dump(intent, f, sort_keys=True)\nrc = subprocess.run([\"python3\", \"$runtime_py_dir/goal_plan_supervisor.py\", \"run\",\n    \"--contract\", \"$state_root/contracts/integration_e2e.json\", \"--intent\", \"$state_root/contracts/integration_e2e.intent.json\",\n    \"--ledger\", \"$state_root/supervisor-ledger.json\", \"--ack\", \"$state_root/acks/integration_e2e.json\",\n    \"--result\", \"$state_root/results/integration_e2e.json\"])\nsup = json.load(open(\"$state_root/results/integration_e2e.json\")) if rc.returncode == 0 and os.path.exists(\"$state_root/results/integration_e2e.json\") else {}\nprint(\"launched\" if sup.get(\"verdict\") == \"EXITED\" and sup.get(\"normalized_exit_code\") == 0 else \"crashed\")\nPYEOF"
  ];
  LaunchLaneD -> ParentVerifyD [condition="context.tool.last_line=launched", weight="2"];
  LaunchLaneD -> InfraCarrier [condition="context.tool.last_line=crashed"];
  ParentVerifyD [
    shape=parallelogram,
    label="Parent-Verify integration_e2e Candidate",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nlane_result = json.load(open(\"$state_root/lane-results/integration_e2e.json\"))\nif lane_result.get(\"result\") != \"candidate\":\n    print(\"skip:\" + lane_result.get(\"blocker_reason\", \"unknown\"))\nelse:\n    registry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\n    result = gpr.run_parent_verifier_envelope(\n        registry=registry, git_argv_prefix=(\"$git_bin\",), target_repo=\"$target_repo\",\n        worktree_root=\"$worktree_root\", worktree_id=\"candidate-integration_e2e\",\n        candidate_sha=lane_result[\"candidate_sha\"],\n        verifier_argv=['bash', '-c', \"test -f scenarios/L6-kanban-app/solution/run.sh && test -f scenarios/L6-kanban-app/solution/seed.py && test -x scenarios/L6-kanban-app/solution/run.sh && test -f scenarios/L6-kanban-app/solution/README.md && grep -q 'alice@example.com' scenarios/L6-kanban-app/solution/seed.py && grep -q 'bob@example.com' scenarios/L6-kanban-app/solution/seed.py\"],\n        timeout_seconds=300, output_root=\"$state_root/verify-out/candidate-integration_e2e\",\n        evidence_path=\"$state_root/evidence/candidate-integration_e2e.json\",\n    )\n    print(result.verdict)\nPYEOF"
  ];
  ParentVerifyD -> IntegrateD [condition="context.tool.last_line=PASS", weight="2"];
  ParentVerifyD -> InfraCarrier [condition="context.tool.last_line=INFRA"];
  ParentVerifyD -> Residuals [condition="context.tool.last_line=FAIL"];
  ParentVerifyD -> Residuals [condition="context.tool.last_line!=PASS"];
  IntegrateD [
    shape=parallelogram,
    label="Integrate integration_e2e (merge + aggregate)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nlane_result = json.load(open(\"$state_root/lane-results/integration_e2e.json\"))\njournal = gpr.IntegrationJournal(\"$state_root/integration-journal.json\", \"$state_root/integration-journal.lock\")\nentry = gpr.integrate_candidate(\n    git_argv_prefix=(\"$git_bin\",), integration_worktree=\"$target_repo\", journal=journal,\n    lane_id=\"integration_e2e\", candidate_sha=lane_result[\"candidate_sha\"],\n    aggregate_verifier_argv=['/bin/sh', '-c', 'test -f artifacts/design_artifacts.done && test -f artifacts/backend_core.done && test -f artifacts/frontend_core.done && test -f artifacts/integration_e2e.done'],\n    aggregate_timeout_seconds=300, output_root=\"$state_root/verify-out/aggregate-after-integration_e2e\",\n    evidence_path=\"$state_root/evidence/aggregate-after-integration_e2e.json\",\n)\nprint(entry[\"result\"])\nPYEOF"
  ];
  IntegrateD -> PreCoherenceAggregate [condition="context.tool.last_line=ACCEPTED", weight="2"];
  IntegrateD -> InfraCarrier [condition="context.tool.last_line=AGGREGATE_INFRA"];
  IntegrateD -> Residuals [condition="context.tool.last_line=MERGE_CONFLICT"];
  IntegrateD -> Residuals [condition="context.tool.last_line=AGGREGATE_FAIL"];

  PreCoherenceAggregate [
    shape=parallelogram,
    label="Pre-Coherence Aggregate",
    tool_command="#!/bin/sh\nset -e\nif test -f artifacts/design_artifacts.done && test -f artifacts/backend_core.done && test -f artifacts/frontend_core.done && test -f artifacts/integration_e2e.done; then printf 'aggregate_ok'; else printf 'aggregate_fail'; fi"
  ];
  PreCoherenceAggregate -> Coherence [condition="context.tool.last_line=aggregate_ok", weight="2"];
  PreCoherenceAggregate -> InfraCarrier [condition="context.tool.last_line=aggregate_fail"];
  Coherence [
    shape=box,
    fidelity="full",
    label="Cross-Lane Coherence Review",
    prompt="All 4 lanes (design_artifacts, backend_core, frontend_core, integration_e2e) are integrated and each marker file is present and independently verified. Review the integrated state for any cross-lane interaction defect (an unintended conflict pattern between the marker files, anything inconsistent across lanes). This is a real run with deliberately scoped per-lane tasks, so in the common case there is nothing to find -- do NOT invent a finding to justify a correction. Write .resolve/coherence/review.json with {\"finding\": true|false, \"description\": \"...\"}. Print the single line: reviewed"
  ];
  Coherence -> CoherenceCheck;
  CoherenceCheck [
    shape=parallelogram,
    label="Coherence Check",
    tool_command="#!/bin/sh\nset -e\nfinding=$(python3 -c \"import json;print(json.load(open('.resolve/coherence/review.json'))['finding'])\" 2>/dev/null || echo False)\nif [ \"$finding\" = \"True\" ]; then printf 'finding'; else printf 'no_finding'; fi"
  ];
  CoherenceCheck -> Correction [condition="context.tool.last_line=finding"];
  CoherenceCheck -> FinalFreeze [condition="context.tool.last_line=no_finding", weight="2"];
  Correction [
    shape=parallelogram,
    label="Launch Integration Correction (bounded, 1 round)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json, subprocess, os, hashlib\nsys.path.insert(0, \"$runtime_py_dir\")\nintegration_head = subprocess.run([\"$git_bin\", \"rev-parse\", \"HEAD\"], cwd=\"$target_repo\", capture_output=True, text=True, check=True).stdout.strip()\nbranch = subprocess.run([\"$git_bin\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\"], cwd=\"$target_repo\", capture_output=True, text=True, check=True).stdout.strip()\nwith open(\"$state_root/aggregate_verifier_argv.json\", \"w\") as f:\n    json.dump(['/bin/sh', '-c', 'test -f artifacts/design_artifacts.done && test -f artifacts/backend_core.done && test -f artifacts/frontend_core.done && test -f artifacts/integration_e2e.done'], f)\ncontract = {\n    \"schema_version\": \"goal-plan.process-launch-contract/v1\",\n    \"process_kind\": \"correction\", \"process_id\": \"integration_correction\", \"process_run_id\": \"$run_id-correction\",\n    \"child_argv\": [\"python3\", \"-m\", \"amplifier_module_pipeline_runner.cli\", \"run\",\n                   \"$subgraphs_dir/integration_correction.dot\", \"--cwd\", \".\", \"--on-human-gate\", \"fail\",\n                   \"--param\", \"integration_branch=\" + branch,\n                   \"--param\", \"allowed_paths_csv=design_artifacts,backend_core,frontend_core,integration_e2e\",\n                   \"--param\", \"runtime_py_dir=$runtime_py_dir\",\n                   \"--param\", \"ledger_path=$state_root/budgets/correction.json\",\n                   \"--param\", \"ledger_lock_path=$state_root/budgets/correction.lock\",\n                   \"--param\", \"run_id=$run_id\",\n                   \"--param\", \"aggregate_verifier_argv_json=$state_root/aggregate_verifier_argv.json\",\n                   \"--param\", \"output_root=$state_root/verify-out/correction\",\n                   \"--param\", \"evidence_path=$state_root/evidence/correction.json\",\n                   \"--param\", \"correction_result_path=$state_root/lane-results/correction.json\"],\n    \"child_cwd\": \"$target_repo\", \"child_env\": {\"PYTHONPATH\": \"$runner_pythonpath\"},\n    \"wall_timeout_seconds\": 3600, \"term_grace_seconds\": 10,\n    \"stdout_path\": \"$state_root/logs/correction.stdout\", \"stderr_path\": \"$state_root/logs/correction.stderr\",\n}\nwith open(\"$state_root/contracts/correction.json\", \"w\") as f:\n    json.dump(contract, f, sort_keys=True)\ncontract_sha = hashlib.sha256(open(\"$state_root/contracts/correction.json\", \"rb\").read()).hexdigest()\nintent = {\"schema_version\": \"goal-plan.launch-intent/v1\", \"process_run_id\": \"$run_id-correction\", \"contract_sha256\": contract_sha}\nwith open(\"$state_root/contracts/correction.intent.json\", \"w\") as f:\n    json.dump(intent, f, sort_keys=True)\nrc = subprocess.run([\"python3\", \"$runtime_py_dir/goal_plan_supervisor.py\", \"run\",\n    \"--contract\", \"$state_root/contracts/correction.json\", \"--intent\", \"$state_root/contracts/correction.intent.json\",\n    \"--ledger\", \"$state_root/supervisor-ledger.json\", \"--ack\", \"$state_root/acks/correction.json\",\n    \"--result\", \"$state_root/results/correction.json\"])\nsup = json.load(open(\"$state_root/results/correction.json\")) if rc.returncode == 0 and os.path.exists(\"$state_root/results/correction.json\") else {}\nif sup.get(\"verdict\") != \"EXITED\" or sup.get(\"normalized_exit_code\") != 0:\n    print(\"crashed\"); sys.exit(0)\nresult = json.load(open(\"$state_root/lane-results/correction.json\"))\nprint(result.get(\"result\", \"crashed\"))\nPYEOF"
  ];
  Correction -> AffectedClosureAggregate [condition="context.tool.last_line=corrected", weight="2"];
  Correction -> Residuals [condition="context.tool.last_line=blocked"];
  Correction -> InfraCarrier [condition="context.tool.last_line=crashed"];
  AffectedClosureAggregate [
    shape=parallelogram,
    label="Affected-Closure + Fresh Coherence Aggregate",
    tool_command="#!/bin/sh\nset -e\nif test -f artifacts/design_artifacts.done && test -f artifacts/backend_core.done && test -f artifacts/frontend_core.done && test -f artifacts/integration_e2e.done; then printf 'aggregate_ok'; else printf 'aggregate_fail'; fi"
  ];
  AffectedClosureAggregate -> FinalFreeze [condition="context.tool.last_line=aggregate_ok", weight="2"];
  AffectedClosureAggregate -> InfraCarrier [condition="context.tool.last_line=aggregate_fail"];
  FinalFreeze [
    shape=parallelogram,
    label="Freeze Final HEAD + Lane Sweep",
    tool_command="#!/bin/sh\nset -e\nfinal_head=$($git_bin rev-parse HEAD)\nprintf '%s' \"$final_head\" > \"$state_root/final_head.txt\"\nif test -f artifacts/design_artifacts.done && grep -qF -e design_artifacts:ok -- artifacts/design_artifacts.done && test -f artifacts/backend_core.done && grep -qF -e backend_core:ok -- artifacts/backend_core.done && test -f artifacts/frontend_core.done && grep -qF -e frontend_core:ok -- artifacts/frontend_core.done && test -f artifacts/integration_e2e.done && grep -qF -e integration_e2e:ok -- artifacts/integration_e2e.done; then printf 'sweep_ok'; else printf 'sweep_fail'; fi"
  ];
  FinalFreeze -> FinalAggregateAfterSweep [condition="context.tool.last_line=sweep_ok", weight="2"];
  FinalFreeze -> InfraCarrier [condition="context.tool.last_line=sweep_fail"];
  FinalAggregateAfterSweep [
    shape=parallelogram,
    label="Final Aggregate After Sweep",
    tool_command="#!/bin/sh\nset -e\nif test -f artifacts/design_artifacts.done && test -f artifacts/backend_core.done && test -f artifacts/frontend_core.done && test -f artifacts/integration_e2e.done; then printf 'aggregate_ok'; else printf 'aggregate_fail'; fi"
  ];
  FinalAggregateAfterSweep -> DeliveryGate [condition="context.tool.last_line=aggregate_ok", weight="2"];
  FinalAggregateAfterSweep -> InfraCarrier [condition="context.tool.last_line=aggregate_fail"];

  DeliveryGate [
    shape=parallelogram,
    label="Delivery Enabled?",
    tool_command="#!/bin/sh\nset -e\nif [ \"$delivery_enabled\" = \"true\" ]; then printf 'deliver'; else printf 'skip_delivery'; fi"
  ];
  DeliveryGate -> Deliver [condition="context.tool.last_line=deliver", weight="2"];
  DeliveryGate -> PreTerminalCleanup [condition="context.tool.last_line=skip_delivery"];
  Deliver [
    shape=folder,
    label="Deliver PR (subgraph)",
    dot_file="$subgraphs_dir/deliver_pr.dot",
    outputs="delivery.pr_url,delivery.result"
  ];
  Deliver -> PreTerminalCleanup [condition="context.delivery.result=opened", weight="2"];
  Deliver -> Residuals [condition="context.delivery.result=failed"];

  PreTerminalCleanup [
    shape=parallelogram,
    label="Pre-Terminal Cleanup",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nauthority = gpr.derive_cleanup_authority(trusted_runtime_verdict=\"PASS\", parent_binding_verdict=\"PASS\")\nrecord = gpr.pre_terminal_cleanup(\n    registry=registry, git_argv_prefix=(\"$git_bin\",), target_repo=\"$target_repo\",\n    authority=authority, result_path=\"$state_root/cleanup-result.json\",\n)\nprint(\"cleaned\")\nPYEOF"
  ];
  PreTerminalCleanup -> Complete;
  Complete [
    shape=parallelogram,
    label="Complete",
    tool_command="printf '{\"terminal.status\": \"COMPLETE\"}'",
    parse_json="true"
  ];
  Complete -> CompleteCarrier;
  Residuals [
    shape=parallelogram,
    label="Residuals (named, evidence-backed)",
    tool_command="printf '{\"terminal.status\": \"RESIDUALS_READY\"}'",
    parse_json="true"
  ];
  Residuals -> ResidualsCleanup;
  ResidualsCleanup [
    shape=parallelogram,
    label="Pre-Terminal Cleanup (residuals path)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nauthority = gpr.derive_cleanup_authority(trusted_runtime_verdict=\"PASS\", parent_binding_verdict=\"PASS\")\nrecord = gpr.pre_terminal_cleanup(\n    registry=registry, git_argv_prefix=(\"$git_bin\",), target_repo=\"$target_repo\",\n    authority=authority, result_path=\"$state_root/cleanup-result-residuals.json\",\n)\nprint(\"cleaned\")\nPYEOF"
  ];
  ResidualsCleanup -> ResidualsCarrier;
  CompleteCarrier [
    shape=parallelogram,
    label="CompleteCarrier",
    tool_command="printf 'COMPLETE'"
  ];
  CompleteCarrier -> Exit;
  ResidualsCarrier [
    shape=parallelogram,
    label="ResidualsCarrier",
    tool_command="printf 'RESIDUALS_READY'"
  ];
  ResidualsCarrier -> Exit;
  InfraCarrier [
    shape=parallelogram,
    label="InfraCarrier",
    tool_command="printf 'INFRA_FAILURE'"
  ];
  InfraCarrier -> Exit;
  AbortedCarrier [
    shape=parallelogram,
    label="AbortedCarrier",
    tool_command="printf 'ABORTED'"
  ];
  AbortedCarrier -> Exit;
}
