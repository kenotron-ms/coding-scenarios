all_timeout_seconds\": 3600, \"term_grace_seconds\": 10,\n    \"stdout_path\": \"$state_root/logs/design_artifacts.stdout\", \"stderr_path\": \"$state_root/logs/design_artifacts.stderr\",\n}\nimport os\nos.makedirs(\"$state_root/contracts\", exist_ok=True)\nos.makedirs(\"$state_root/lane-results\", exist_ok=True)\nos.makedirs(\"$state_root/logs\", exist_ok=True)\nos.makedirs(\"$state_root/acks\", exist_ok=True)\nos.makedirs(\"$state_root/results\", exist_ok=True)\nimport hashlib\nwith open(\"$state_root/contracts/design_artifacts.json\", \"w\") as f:\n    json.dump(contract, f, sort_keys=True)\ncontract_sha = hashlib.sha256(open(\"$state_root/contracts/design_artifacts.json\", \"rb\").read()).hexdigest()\nintent = {\"schema_version\": \"goal-plan.launch-intent/v1\", \"process_run_id\": \"$run_id-design_artifacts\", \"contract_sha256\": contract_sha}\nwith open(\"$state_root/contracts/design_artifacts.intent.json\", \"w\") as f:\n    json.dump(intent, f, sort_keys=True)\nrc = subprocess.run([\"python3\", \"$runtime_py_dir/goal_plan_supervisor.py\", \"run\",\n    \"--contract\", \"$state_root/contracts/design_artifacts.json\", \"--intent\", \"$state_root/contracts/design_artifacts.intent.json\",\n    \"--ledger\", \"$state_root/supervisor-ledger.json\", \"--ack\", \"$state_root/acks/design_artifacts.json\",\n    \"--result\", \"$state_root/results/design_artifacts.json\"])\nprint(\"launched\" if rc.returncode == 0 else \"supervisor_infra_failure\")\nPYEOF"
