    shape=parallelogram,
    label="Coherence Check",
    tool_command="#!/bin/sh\nset -e\nfinding=$(python3 -c \"import json;print(json.load(open('.resolve/coherence/review.json'))['finding'])\" 2>/dev/null || echo False)\nif [ \"$finding\" = \"True\" ]; then printf 'finding'; else printf 'no_finding'; fi"
  ];
  CoherenceCheck -> Correction [condition="context.tool.last_line=finding"];
  CoherenceCheck -> FinalFreeze [condition="context.tool.last_line=no_finding", weight="2"];
  Correction [
    shape=parallelogram,
    label="Launch Integration Correction (bounded, 1 round)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json, subprocess, os, hashlib\nsys.path.insert(0, \"$runtime_py_dir\")\nintegration_head = subprocess.run([\"$git_bin\", \"rev-parse\", \"HEAD\"], cwd=\"$target_repo\", capture_output=True, text=True, check=True).stdout.strip()\nbranch = subprocess.run([\"$git_bin\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\"], cwd=\"$target_repo\", capture_output=True, text=True, check=True).stdout.strip()\nwith open(\"$state_root/aggregate_verifier_argv.json\", \"w\") as f:\n    json.dump(['/bin/sh', '-c', 'test -f artifacts/sprint_0_mvp.done && test -f artifacts/sprint_1_ordering.done && test -f artifacts/sprint_2_auth.done && test -f artifacts/sprint_3_labels.done && test -f artifacts/sprint_4_activity.done'], f)\ncontract = {\n    \"schema_version\": \"goal-plan.process-launch-contract/v1\",\n    \"process_kind\": \"correction\", \"process_id\": \"integration_correction\", \"process_run_id\": \"$run_id-correction\",\n    \"child_argv\": [\"python3\", \"-m\", \"amplifier_module_pipeline_runner.cli\", \"run\",\n                   \"$subgraphs_dir/integration_correction.dot\", \"--cwd\", \".\", \"--on-human-gate\", \"fail\",\n                   \"--param\", \"integration_branch=\" + branch,\n                   \"--param\", \"allowed_paths_csv=sprint_0_mvp,sprint_1_ordering,sprint_2_auth,sprint_3_labels,sprint_4_activity\",\n                   \"--param\", \"runtime_py_dir=$runtime_py_dir\",\n                   \"--param\", \"ledger_path=$state_root/budgets/correction.json\",\n                   \"--param\", \"ledger_lock_path=$state_root/budgets/correction.lock\",\n                   \"--param\", \"run_id=$run_id\",\n                   \"--param\", \"aggregate_verifier_argv_json=$state_root/aggregate_verifier_argv.json\",\n                   \"--param\", \"output_root=$state_root/verify-out/correction\",\n                   \"--param\", \"evidence_path=$state_root/evidence/correction.json\",\n                   \"--param\", \"correction_result_path=$state_root/lane-results/correction.json\"],\n    \"child_cwd\": \"$target_repo\", \"child_env\": {\"PYTHONPATH\": \"$runner_pythonpath\"},\n    \"wall_timeout_seconds\": 3600, \"term_grace_seconds\": 10,\n    \"stdout_path\": \"$state_root/logs/correction.stdout\", \"stderr_path\": \"$state_root/logs/correction.stderr\",\n}\nwith open(\"$state_root/contracts/correction.json\", \"w\") as f:\n    json.dump(contract, f, sort_keys=True)\ncontract_sha = hashlib.sha256(open(\"$state_root/contracts/correction.json\", \"rb\").read()).hexdigest()\nintent = {\"schema_version\": \"goal-plan.launch-intent/v1\", \"process_run_id\": \"$run_id-correction\", \"contract_sha256\": contract_sha}\nwith open(\"$state_root/contracts/correction.intent.json\", \"w\") as f:\n    json.dump(intent, f, sort_keys=True)\nrc = subprocess.run([\"python3\", \"$runtime_py_dir/goal_plan_supervisor.py\", \"run\",\n    \"--contract\", \"$state_root/contracts/correction.json\", \"--intent\", \"$state_root/contracts/correction.intent.json\",\n    \"--ledger\", \"$state_root/supervisor-ledger.json\", \"--ack\", \"$state_root/acks/correction.json\",\n    \"--result\", \"$state_root/results/correction.json\"])\nsup = json.load(open(\"$state_root/results/correction.json\")) if rc.returncode == 0 and os.path.exists(\"$state_root/results/correction.json\") else {}\nif sup.get(\"verdict\") != \"EXITED\" or sup.get(\"normalized_exit_code\") != 0:\n    print(\"crashed\"); sys.exit(0)\nresult = json.load(open(\"$state_root/lane-results/correction.json\"))\nprint(result.get(\"result\", \"crashed\"))\nPYEOF"
  ];
  Correction -> AffectedClosureAggregate [condition="context.tool.last_line=corrected", weight="2"];
  Correction -> Residuals [condition="context.tool.last_line=blocked"];
  Correction -> InfraCarrier [condition="context.tool.last_line=crashed"];
  AffectedClosureAggregate [
    shape=parallelogram,
    label="Affected-Closure + Fresh Coherence Aggregate",
    tool_command="#!/bin/sh\nset -e\nif test -f artifacts/sprint_0_mvp.done && test -f artifacts/sprint_1_ordering.done && test -f artifacts/sprint_2_auth.done && test -f artifacts/sprint_3_labels.done && test -f artifacts/sprint_4_activity.done; then printf 'aggregate_ok'; else printf 'aggregate_fail'; fi"
  ];
  AffectedClosureAggregate -> FinalFreeze [condition="context.tool.last_line=aggregate_ok", weight="2"];
  AffectedClosureAggregate -> InfraCarrier [condition="context.tool.last_line=aggregate_fail"];
  FinalFreeze [
    shape=parallelogram,
    label="Freeze Final HEAD + Lane Sweep",
    tool_command="#!/bin/sh\nset -e\nfinal_head=$($git_bin rev-parse HEAD)\nprintf '%s' \"$final_head\" > \"$state_root/final_head.txt\"\nif test -f artifacts/sprint_0_mvp.done && grep -qF -e sprint_0_mvp:ok -- artifacts/sprint_0_mvp.done && test -f artifacts/sprint_1_ordering.done && grep -qF -e sprint_1_ordering:ok -- artifacts/sprint_1_ordering.done && test -f artifacts/sprint_2_auth.done && grep -qF -e sprint_2_auth:ok -- artifacts/sprint_2_auth.done && test -f artifacts/sprint_3_labels.done && grep -qF -e sprint_3_labels:ok -- artifacts/sprint_3_labels.done && test -f artifacts/sprint_4_activity.done && grep -qF -e sprint_4_activity:ok -- artifacts/sprint_4_activity.done; then printf 'sweep_ok'; else printf 'sweep_fail'; fi"
  ];
  FinalFreeze -> FinalAggregateAfterSweep [condition="context.tool.last_line=sweep_ok", weight="2"];
  FinalFreeze -> InfraCarrier [condition="context.tool.last_line=sweep_fail"];
  FinalAggregateAfterSweep [
    shape=parallelogram,
    label="Final Aggregate After Sweep",
    tool_command="#!/bin/sh\nset -e\nif test -f artifacts/sprint_0_mvp.done && test -f artifacts/sprint_1_ordering.done && test -f artifacts/sprint_2_auth.done && test -f artifacts/sprint_3_labels.done && test -f artifacts/sprint_4_activity.done; then printf 'aggregate_ok'; else printf 'aggregate_fail'; fi"
  ];
  FinalAggregateAfterSweep -> DeliveryGate [condition="context.tool.last_line=aggregate_ok", weight="2"];
  FinalAggregateAfterSweep -> InfraCarrier [condition="context.tool.last_line=aggregate_fail"];

  DeliveryGate [
    shape=parallelogram,
    label="Delivery Enabled?",
    tool_command="#!/bin/sh\nset -e\nif [ \"$delivery_enabled\" = \"true\" ]; then printf 'deliver'; else printf 'skip_delivery'; fi"
  ];
  DeliveryGate -> Deliver [condition="context.tool.last_line=deliver", weight="2"];
  DeliveryGate -> PreTerminalCleanup [condition="context.tool.last_line=skip_delivery"];
  Deliver [
    shape=folder,
    label="Deliver PR (subgraph)",
    dot_file="$subgraphs_dir/deliver_pr.dot",
    outputs="delivery.pr_url,delivery.result"
  ];
  Deliver -> PreTerminalCleanup [condition="context.delivery.result=opened", weight="2"];
  Deliver -> Residuals [condition="context.delivery.result=failed"];

  PreTerminalCleanup [
    shape=parallelogram,
    label="Pre-Terminal Cleanup",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nauthority = gpr.derive_cleanup_authority(trusted_runtime_verdict=\"PASS\", parent_binding_verdict=\"PASS\")\nrecord = gpr.pre_terminal_cleanup(\n    registry=registry, git_argv_prefix=(\"$git_bin\",), target_repo=\"$target_repo\",\n    authority=authority, result_path=\"$state_root/cleanup-result.json\",\n)\nprint(\"cleaned\")\nPYEOF"
  ];
  PreTerminalCleanup -> Complete;
  Complete [
    shape=parallelogram,
    label="Complete",
    tool_command="printf '{\"terminal.status\": \"COMPLETE\"}'",
    parse_json="true"
  ];
  Complete -> CompleteCarrier;
  Residuals [
    shape=parallelogram,
    label="Residuals (named, evidence-backed)",
    tool_command="printf '{\"terminal.status\": \"RESIDUALS_READY\"}'",
    parse_json="true"
  ];
  Residuals -> ResidualsCleanup;
  ResidualsCleanup [
    shape=parallelogram,
    label="Pre-Terminal Cleanup (residuals path)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nauthority = gpr.derive_cleanup_authority(trusted_runtime_verdict=\"PASS\", parent_binding_verdict=\"PASS\")\nrecord = gpr.pre_terminal_cleanup(\n    registry=registry, git_argv_prefix=(\"$git_bin\",), target_repo=\"$target_repo\",\n    authority=authority, result_path=\"$state_root/cleanup-result-residuals.json\",\n)\nprint(\"cleaned\")\nPYEOF"
  ];
  ResidualsCleanup -> ResidualsCarrier;
  CompleteCarrier [
    shape=parallelogram,
    label="CompleteCarrier",
    tool_command="printf 'COMPLETE'"
  ];
  CompleteCarrier -> Exit;
  ResidualsCarrier [
    shape=parallelogram,
    label="ResidualsCarrier",
    tool_command="printf 'RESIDUALS_READY'"
  ];
  ResidualsCarrier -> Exit;
  InfraCarrier [
    shape=parallelogram,
    label="InfraCarrier",
    tool_command="printf 'INFRA_FAILURE'"
  ];
  InfraCarrier -> Exit;
  AbortedCarrier [
    shape=parallelogram,
    label="AbortedCarrier",
    tool_command="printf 'ABORTED'"
  ];
  AbortedCarrier -> Exit;
}
