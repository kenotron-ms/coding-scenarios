    shape=parallelogram,
    label="Launch implement_lru_cache",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json, subprocess\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\nregistry = gpr.WorktreeRegistry(\"$state_root/run-owned-worktrees.json\", \"$state_root/run-owned-worktrees.lock\")\nwt = gpr.create_registered_worktree(registry, (\"$git_bin\",), \"$target_repo\", \"$worktree_root\", \"implement_lru_cache\", kind=\"lane\", commit_sha=\"$product_base_sha\", branch=\"issue-10/implement_lru_cache\")\ncontract = {\n    \"schema_version\": \"goal-plan.process-launch-contract/v1\",\n    \"process_kind\": \"lane\", \"process_id\": \"implement_lru_cache\", \"process_run_id\": \"$run_id-implement_lru_cache\",\n    \"child_argv\": [\"python3\", \"-m\", \"amplifier_module_pipeline_runner.cli\", \"run\",\n                   \"$subgraphs_dir/goal_lane_impl.dot\", \"--cwd\", \".\", \"--on-human-gate\", \"fail\",\n                   \"--param\", \"lane_id=implement_lru_cache\", \"--param\", \"marker_file=artifacts/implement_lru_cache.done\",\n                   \"--param\", \"marker_content=implement_lru_cache:ok\", \"--param\", \"seeded_failure=false\",\n                   \"--param\", \"runtime_py_dir=$runtime_py_dir\",\n                   \"--param\", \"output_root=$state_root/verify-out/implement_lru_cache\",\n                   \"--param\", \"evidence_path=$state_root/evidence/implement_lru_cache.json\",\n                   \"--param\", \"lane_result_path=$state_root/lane-results/implement_lru_cache.json\",\n                   \"--param\", \"ledger_path=$state_root/budgets/implement_lru_cache.json\",\n                   \"--param\", \"ledger_lock_path=$state_root/budgets/implement_lru_cache.lock\",\n                   \"--param\", \"run_id=$run_id\", \"--param\", \"max_attempts=3\", \"--param\", \"goal_condition_file=/home/runner/work/coding-scenarios/coding-scenarios/generated/plans/32927205352/goals/implement_lru_cache.goal.md\"],\n    \"child_cwd\": wt, \"child_env\": {\"PYTHONPATH\": \"$runner_pythonpath\"},\n    \"wall_timeout_seconds\": 3600, \"term_grace_seconds\": 10,\n    \"stdout_path\": \"$state_root/logs/implement_lru_cache.stdout\", \"stderr_path\": \"$state_root/logs/implement_lru_cache.stderr\",\n}\nimport os\nos.makedirs(\"$state_root/contracts\", exist_ok=True)\nos.makedirs(\"$state_root/lane-results\", exist_ok=True)\nos.makedirs(\"$state_root/logs\", exist_ok=True)\nos.makedirs(\"$state_root/acks\", exist_ok=True)\nos.makedirs(\"$state_root/results\", exist_ok=True)\nimport hashlib\nwith open(\"$state_root/contracts/implement_lru_cache.json\", \"w\") as f:\n    json.dump(contract, f, sort_keys=True)\ncontract_sha = hashlib.sha256(open(\"$state_root/contracts/implement_lru_cache.json\", \"rb\").read()).hexdigest()\nintent = {\"schema_version\": \"goal-plan.launch-intent/v1\", \"process_run_id\": \"$run_id-implement_lru_cache\", \"contract_sha256\": contract_sha}\nwith open(\"$state_root/contracts/implement_lru_cache.intent.json\", \"w\") as f:\n    json.dump(intent, f, sort_keys=True)\nrc = subprocess.run([\"python3\", \"$runtime_py_dir/goal_plan_supervisor.py\", \"run\",\n    \"--contract\", \"$state_root/contracts/implement_lru_cache.json\", \"--intent\", \"$state_root/contracts/implement_lru_cache.intent.json\",\n    \"--ledger\", \"$state_root/supervisor-ledger.json\", \"--ack\", \"$state_root/acks/implement_lru_cache.json\",\n    \"--result\", \"$state_root/results/implement_lru_cache.json\"])\nprint(\"launched\" if rc.returncode == 0 else \"supervisor_infra_failure\")\nPYEOF"
