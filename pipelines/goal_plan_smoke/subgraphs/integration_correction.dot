// integration_correction.dot
//
// Bounded shared-branch correction graph for the goal_plan_smoke family
// (design doc Task 6, second half). Launched by the parent AFTER all waves
// have integrated and a fresh cross-lane coherence review has requested one
// statically-bounded correction round (plan.json: correction.max_rounds=1).
// Runs headless in the CURRENT integration worktree/branch -- never a lane
// worktree, never a fresh branch -- and is restricted to the responsible
// lanes' owned-path union plus any explicitly declared seam paths; it must
// not touch anything outside that set.
//
// Reuses goal_plan_runtime.py's `run_child_attempt_verifier_envelope`
// unchanged, exactly like subgraphs/goal_lane.dot's ChildVerify -- this file
// never edits that module.
//
// Required context ($param):
//   $integration_branch     - name of the branch this graph must stay on
//   $allowed_paths_csv       - comma-separated list of paths this round may
//                             modify (responsible-lane-owned union + seams)
//   $runtime_py_dir
//   $ledger_path, $ledger_lock_path, $run_id
//   $aggregate_verifier_argv_json - path to a JSON file: an argv array
//   $output_root, $evidence_path
//   $max_correction_attempts (informational; BudgetLedger.max_integration_corrections
//                             is the authoritative cap -- see plan.json)
//
// Context outputs:
//   correction.result        - "corrected" | "blocked"
//   correction.candidate_sha  - set only when correction.result="corrected"
//   correction.blocker_reason - set only when correction.result="blocked"

digraph integration_correction {
  graph [rankdir=LR, default_max_retry=1, default_fidelity="summary:high"];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Deterministic: confirm we are actually on the declared integration
  // branch before touching anything -- a correction round that silently
  // ran on the wrong branch would be worse than no correction at all.
  ConfirmBranch [
    shape=parallelogram, label="Confirm Integration Branch",
    tool_command="#!/bin/sh\nset -e\ncur=$(git rev-parse --abbrev-ref HEAD)\nif [ \"$cur\" = \"$integration_branch\" ]; then printf 'on_branch'; else printf 'wrong_branch'; fi"
  ];
  Start -> ConfirmBranch;
  ConfirmBranch -> ReserveCorrection [condition="context.tool.last_line=on_branch", weight="2"];
  ConfirmBranch -> InfraExit         [condition="context.tool.last_line=wrong_branch"];

  ReserveCorrection [
    shape=parallelogram, label="Reserve Correction Round",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\ntry:\n    limits = gpr.BudgetLimits(\n        max_total_attempts=999,\n        max_process_launches=999,\n        max_integration_corrections=1,\n        max_pipeline_seconds=999999.0,\n    )\n    ledger = gpr.BudgetLedger(\"$ledger_path\", \"$ledger_lock_path\", limits, run_id=\"$run_id\")\n    ledger.reserve_correction(\"$integration_branch\" + \":round-1\")\n    print(\"reserved\")\nexcept gpr.GoalPlanRuntimeError as e:\n    print(\"exhausted:\" + str(e))\nPYEOF"
  ];
  ReserveCorrection -> Attempt          [condition="context.tool.last_line=reserved", weight="2"];
  ReserveCorrection -> BudgetExhausted  [condition="context.tool.last_line!=reserved"];

  // LLM judgment node, restricted to the declared seam/ownership union.
  // Deliberately does NOT re-derive the whole review from scratch -- it is
  // handed the specific coherence finding from the parent and must fix
  // exactly that, nothing else (RUBRIC.md tier discipline + idempotency).
  Attempt [
    shape=box, fidelity="full",
    label="Correct",
    prompt="A fresh cross-lane coherence review found a real defect in the integrated result on branch $integration_branch. You may modify ONLY these paths (the responsible lanes' owned-path union plus any declared seams): $allowed_paths_csv -- any change outside this set is out of scope for this correction round and must not be made. Read .goal_lane_feedback.txt if it exists (a prior correction attempt's curated critique) and address it. Make the minimal change that fixes the coherence finding. After making the change, append 1 to the integer in .correction_iteration (create it with value 0 first if absent, idempotent). Print the single line: corrected"
  ];

  Attempt -> ChildVerify;

  ChildVerify [
    shape=parallelogram, label="Child Verify (aggregate envelope)",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport sys, json, os\nsys.path.insert(0, \"$runtime_py_dir\")\nimport goal_plan_runtime as gpr\n# Read the iteration counter INSIDE python -- see goal_lane.dot's ChildVerify\n# comment for why a shell $n never interpolates inside a quoted heredoc.\nn = open(\".correction_iteration\").read().strip() if os.path.exists(\".correction_iteration\") else \"0\"\nwith open(\"$aggregate_verifier_argv_json\") as f:\n    verifier_argv = json.load(f)\nresult = gpr.run_child_attempt_verifier_envelope(\n    git_argv_prefix=(\"git\",),\n    worktree_path=\".\",\n    verifier_argv=verifier_argv,\n    timeout_seconds=60,\n    output_root=\"$output_root/correction-\" + n,\n    evidence_path=\"$evidence_path\",\n)\nprint(result.verdict)\nPYEOF"
  ];

  ChildVerify -> Candidate  [condition="context.tool.last_line=PASS && outcome=success", weight="2"];
  ChildVerify -> Diagnose   [condition="context.tool.last_line=FAIL && outcome=success"];
  ChildVerify -> InfraExit  [condition="context.tool.last_line=INFRA && outcome=success"];
  ChildVerify -> InfraExit  [condition="outcome=fail", runs_on="failure"]; // safety net (RUBRIC.md 3.2)

  Candidate [
    shape=parallelogram, label="Commit Correction",
    tool_command="#!/bin/sh\nset -e\ngit add -A\ngit commit --quiet -m \"goal_plan_smoke(integration_correction): bounded coherence fix\"\nsha=$(git rev-parse HEAD)\nprintf '{\"result\": \"corrected\", \"candidate_sha\": \"%s\"}' \"$sha\" > \"$correction_result_path\"\nprintf '{\"correction.result\": \"corrected\", \"correction.candidate_sha\": \"%s\"}' \"$sha\"",
    parse_json="true"
  ];
  Candidate -> Exit;

  // Correction is bounded to exactly one round by contract (plan.json
  // correction.max_rounds=1, enforced by ReserveCorrection's
  // max_integration_corrections=1) -- so unlike goal_lane.dot's open-ended
  // retry loop, a FAIL here curates feedback and hands back a named
  // blocker rather than looping again; the parent decides whether to
  // surface RESIDUALS_READY from here.
  Diagnose [
    shape=box, fidelity="full",
    label="Diagnose (single-shot)",
    prompt="The correction attempt on branch $integration_branch failed independent verification (see $evidence_path). This is a single-shot bounded correction -- there is no further automatic retry. Write .goal_lane_feedback.txt with a precise description of what was tried and why it did not pass, so a human or a later run can pick this up. Print the single line: diagnosed"
  ];
  Diagnose -> BlockedExit;

  BudgetExhausted [
    shape=parallelogram, label="Budget Exhausted",
    tool_command="printf '{\"correction.blocker_reason\": \"budget_exhausted\"}'",
    parse_json="true"
  ];
  BudgetExhausted -> BlockedExit;

  InfraExit [
    shape=parallelogram, label="Infra Failure", runs_on="always",
    tool_command="printf '{\"correction.blocker_reason\": \"infra_failure\"}'",
    parse_json="true"
  ];
  InfraExit -> BlockedExit;

  BlockedExit [
    shape=parallelogram, label="Blocked Exit", runs_on="always",
    tool_command="#!/bin/sh\nset -e\nprintf '{\"result\": \"blocked\", \"blocker_reason\": \"${correction.blocker_reason}\"}' > \"$correction_result_path\"\nprintf '{\"correction.result\": \"blocked\"}'",
    parse_json="true"
  ];
  BlockedExit -> Exit;
}
